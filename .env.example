# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=8080

# Which app/website addresses may connect (comma separated). Use * only while testing.
CORS_ORIGINS=*

# PostgreSQL. Leave empty to use temporary in-memory storage while testing.
DATABASE_URL=postgres://minus:minus@localhost:5432/minus

# Firebase Admin credentials from YOUR Firebase project
# (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Local testing only: accept tokens like "dev:alice:Alice". Must be false in production.
DEV_AUTH=true

# Game timing (milliseconds)
BOT_DELAY_MS=900
TURN_TIMEOUT_MS=30000
ROUND_PAUSE_MS=5000
